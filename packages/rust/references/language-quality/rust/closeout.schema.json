{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://northstar.invalid/schemas/rust-quality-closeout.v1.json",
  "title": "Northstar Rust everyday closeout",
  "type": "object",
  "required": ["schema_version", "repository_root", "snapshot_sha256", "source_identity", "attempt", "changed_files", "rust_anchors", "applicable_rules", "evidence", "limitations", "artifact_root"],
  "properties": {
    "schema_version": { "const": "northstar.rust-quality.closeout.v1" },
    "repository_root": { "type": "string", "minLength": 1 },
    "snapshot_sha256": { "$ref": "#/$defs/sha256" },
    "source_identity": { "type": "string", "minLength": 1 },
    "attempt": { "type": "integer", "minimum": 1 },
    "changed_files": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/path" } },
    "rust_anchors": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/path" } },
    "applicable_rules": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^RUST-[A-Z]+-[0-9]{3}$" } },
    "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } },
    "limitations": { "type": "array", "items": { "$ref": "#/$defs/limitation" } },
    "artifact_root": { "type": "string", "minLength": 1 },
    "committed_range": { "$ref": "#/$defs/committed_range" },
    "reused_evidence": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "path": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$" },
    "direct_surface": {
      "type": "object",
      "required": ["packages", "workspaces"],
      "properties": {
        "packages": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "workspaces": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/path" } }
      },
      "additionalProperties": false
    },
    "committed_range": {
      "type": "object",
      "required": ["base_commit", "head_commit", "checkout_commit", "identity_sha256", "direct_surface", "preserved_dirty_files"],
      "properties": {
        "base_commit": { "$ref": "#/$defs/commit" },
        "head_commit": { "$ref": "#/$defs/commit" },
        "checkout_commit": { "$ref": "#/$defs/commit" },
        "identity_sha256": { "$ref": "#/$defs/sha256" },
        "direct_surface": { "$ref": "#/$defs/direct_surface" },
        "preserved_dirty_files": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/path" } }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "required": ["evidence_id", "evidence_class", "status", "warning_count", "diagnostic_identifiers", "catalogue_evidence", "mapping_dispositions"],
      "properties": {
        "evidence_id": { "type": "string", "minLength": 1 },
        "evidence_class": { "enum": ["compiler", "lint", "docs", "test", "graph", "scanner"] },
        "status": { "enum": ["passed", "warning", "failed", "unavailable", "unrun"] },
        "warning_count": { "type": "integer", "minimum": 0 },
        "diagnostic_identifiers": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "catalogue_evidence": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^RUST-[A-Z]+-[0-9]{3}$" } },
        "mapping_dispositions": { "type": "array", "uniqueItems": true, "items": { "enum": ["promote_enforcement", "promote_evidence", "evaluation_only", "retain_manual"] } }
      },
      "additionalProperties": false
    },
    "limitation": {
      "type": "object",
      "required": ["key", "kind", "evidence"],
      "properties": {
        "key": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "minLength": 1 },
        "evidence": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      },
      "additionalProperties": false
    }
  }
}
